{
  "name": "@quantovainc/qlaunch",
  "version": "0.1.0",
  "description": "Quantum secure launch and payload manifest records for space launch. Proves the manifest, license, liftoff, payload deployment and outcome of a launch, with ML-DSA-65 under FIPS 204 and Quantova time proofs. No operator data ever leaves the party that holds it.",
