  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "wasm/qlaunch_native.js",
    "wasm/qlaunch_native_bg.wasm",
    "wasm/qlaunch_native.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qstamp": "0.6.14"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "space",
    "launch",
    "payload-manifest",
    "spaceflight",
    "ml-dsa",
    "fips-204",
